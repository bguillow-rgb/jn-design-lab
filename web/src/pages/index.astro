---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroRotator from '../components/HeroRotator.astro';
import { url } from '../consts';

// Hero reel. Swap to video later by passing videoSrc={url('/assets/reel.mp4')}
// to HeroRotator; the first slide stays as the poster frame.
const heroSlides = [
  { src: url('/assets/photos/cockpit.jpg'), alt: 'Joe Neiman at the controls of his TBM at sunset, headset on' },
  { src: url('/assets/photos/wing-sunset.jpg'), alt: 'Sunset over the wing at altitude' },
  { src: url('/assets/photos/joe-porsche-wide.jpg'), alt: 'Joe Neiman standing beside a white air-cooled Porsche 911', pos: 'center 30%' },
  { src: url('/assets/photos/waco.jpg'), alt: 'Red Waco YMF-5 biplane in a hangar' },
  { src: url('/assets/photos/tbm-door.jpg'), alt: 'Joe Neiman giving a thumbs-up from the open door of his TBM on the ramp' },
];
---
<BaseLayout path="" wide hero>
  <link slot="head" rel="preload" as="image" href={heroSlides[0].src} fetchpriority="high" />

  <!-- 1. full-height rotating hero -->
  <HeroRotator slides={heroSlides}>
    <h1 class="sr-only">Joe Neiman</h1>
    <p class="lede">
      I'm an average guy who has been able to achieve some pretty incredible
      outcomes through a combination of thinking big, trusting my gut, learning
      from failures and mistakes, pushing the boundaries of what is reasonable
      or realistic, trying hard, and plenty of luck along the way.
    </p>
    <a class="btn btn-ghost-light" href={url('/contact')}>Contact</a>
  </HeroRotator>

  <!-- 2. ventures grid, duotone cards -->
  <section class="band band-light full-bleed">
    <div class="band-inner">
      <span class="eyebrow" data-rise>Ventures</span>
      <h2 style="margin-top: 0;" data-rise>Around here</h2>
      <ul class="venture-grid">
        <li data-rise>
          <a class="venture-card" href={url('/ventures')}>
            <span class="vc-media">
              <img src={url('/assets/photos/ipo-day-nasdaq.jpg')} alt="Joe Neiman at the Nasdaq podium on ACV's IPO day" style="object-position: center 20%;" loading="lazy" decoding="async" width="568" height="696" />
              <span class="vc-name">ACV Auctions</span>
            </span>
            <span class="vc-sub">Online wholesale auto auctions, Buffalo, NY.</span>
          </a>
        </li>
        <li data-rise>
          <a class="venture-card" href={url('/ventures')}>
            <span class="vc-media">
              <img src={url('/assets/photos/nada-cars-commerce.jpg')} alt="Joe Neiman and the team at the NADA Show announcement that DealerClub is now part of Cars Commerce" loading="lazy" decoding="async" width="1600" height="1200" />
              <span class="vc-name">DealerClub</span>
            </span>
            <span class="vc-sub">The reputation-based wholesale auction.</span>
          </a>
        </li>
        <li data-rise>
          <a class="venture-card" href={url('/about')}>
            <span class="vc-media">
              <img src={url('/assets/photos/joe-porsche-lean.jpg')} alt="Joe Neiman leaning on a white Porsche 911 with blue stripes" style="object-position: center 18%;" loading="lazy" decoding="async" width="1800" height="1200" />
              <span class="vc-name">In Demand Auto</span>
            </span>
            <span class="vc-sub">A used car dealership in Albany that sold 40+ cars a month, largely on eBay.</span>
          </a>
        </li>
        <li data-rise>
          <a class="venture-card" href={url('/ventures')}>
            <span class="vc-media">
              <img src={url('/assets/photos/cessna-ttx.jpg')} alt="Joe Neiman on the ramp with a Cessna TTx" style="object-position: center 35%;" loading="lazy" decoding="async" width="1200" height="1600" />
              <span class="vc-name">Buying now</span>
            </span>
            <span class="vc-sub">Franchise car dealerships: buying, selling, and brokering.</span>
          </a>
        </li>
      </ul>
      <a class="btn btn-ghost" href={url('/ventures')} data-rise>Ventures</a>
    </div>
  </section>

  <!-- 3. dark feature band: the book + speaking -->
  <section class="band band-dark on-dark full-bleed">
    <img class="band-bg" src={url('/assets/photos/studio-set.jpg')} alt="" style="object-position: center 8%;" aria-hidden="true" loading="lazy" decoding="async" />
    <div class="band-scrim"></div>
    <div class="band-inner">
      <div class="measure">
        <span class="eyebrow gold" data-rise>Writing and speaking</span>
        <h2 style="margin-top: 0;" data-rise>There will be a book about this someday.</h2>
        <p data-rise>
          I'm starting to write the stories down. I've been telling them for years
          on podcasts and panels, and I still do.
        </p>
        <div class="btn-row" data-rise>
          <a class="btn btn-ghost-light" href={url('/writing')}>Writing</a>
          <a class="btn btn-ghost-light" href={url('/speaking')}>Speaking</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. gold quote band -->
  <section class="band band-gold full-bleed">
    <div class="band-inner">
      <blockquote data-rise>
        &ldquo;Discipline is not a punishment. It is actually the key that unlocks
        your freedom and ability to pursue and accomplish the goals you desire to
        achieve.&rdquo;
      </blockquote>
      <cite data-rise>Joe Neiman</cite>
      <div class="btn-row" data-rise>
        <a class="btn" href={url('/about')}>About</a>
        <a class="btn btn-ghost" href={url('/giving')}>Giving</a>
      </div>
    </div>
  </section>

  <!-- 5. dark band with floating white about card -->
  <section class="band band-dark on-dark full-bleed">
    <img class="band-bg" src={url('/assets/photos/flying-headset.jpg')} alt="" style="object-position: center 5%;" aria-hidden="true" loading="lazy" decoding="async" />
    <div class="band-scrim"></div>
    <div class="band-inner">
      <div class="about-card" data-rise>
        <div class="ac-text">
          <span class="eyebrow">About</span>
          <p class="lede">
            I grew up about 20 minutes outside of Albany, New York, in a pretty
            forgettable rural town. I learned the value of hard work early on through
            a combination of manual labor as a landscaper and construction worker and
            mechanic, as well as buying and selling cars in my parents' driveway
            starting at 15 years old.
          </p>
          <p>
            The driveway turned into a dealership, the dealership turned into
            co-founding <a href={url('/about')}>ACV Auctions</a>, and ACV led to
            founding DealerClub. These days I fly, I buy and sell airplanes for fun,
            and I'm building a portfolio of
            franchise car dealerships. There will be a book about all of it someday.
          </p>
          <a class="btn" href={url('/about')}>The story</a>
        </div>
        <figure>
          <img src={url('/assets/photos/joe-portrait.jpg')} alt="Portrait of Joe Neiman" loading="lazy" decoding="async" width="1066" height="1600" />
        </figure>
      </div>
    </div>
  </section>

  <!-- 6. conversion section: the ask -->
  <section class="band band-light full-bleed">
    <div class="band-inner">
      <div class="split flip">
        <div>
          <span class="eyebrow" data-rise>Contact</span>
          <h2 data-rise>What I'm looking for</h2>
          <p data-rise>
            I'm building a portfolio of franchise car dealerships because I believe in
            the resiliency of the US auto industry and the dependency and cultural
            stronghold that automobiles provide. I buy and sell airplanes for fun. I'm
            interested in early stage companies doing neat things with health and
            wellness, marketplaces, and transportation, and I am always interested in
            air-cooled Porsches and other specialty cars and trucks. If you've got one
            of those, <a href={url('/contact')}>I want to hear about it</a>.
          </p>
          <a class="cta cta-blue" href={url('/contact')} data-rise>Bring me a deal</a>
        </div>
        <figure data-rise>
          <img src={url('/assets/photos/joe-porsche-wide.jpg')} alt="Joe Neiman standing beside a white air-cooled Porsche 911" width="1800" height="1200" loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
  </section>
</BaseLayout>
