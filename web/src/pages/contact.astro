---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, url } from '../consts';

const linkedIn = SITE.sameAs[0];
---
<BaseLayout wide title="Contact" path="/contact" description="Reach Joe Neiman about dealerships, airplanes, early-stage companies, speaking, or Merici.">
  <header class="page-title">
    <span class="eyebrow">Joe Neiman</span>
    <h1>Contact</h1>
  </header>

  <section class="chapter prose" data-rise>
    <p class="lede">What belongs in my inbox:</p>
  </section>

  <ul class="card-grid static" data-rise>
    <li>A franchise dealership for sale, or a seller who'd rather skip the public listing.</li>
    <li>An airplane worth a look.</li>
    <li>An early-stage company in health and wellness, marketplaces, or transportation.</li>
    <li>A speaking invitation where real stories are welcome.</li>
    <li>Anything Merici-related.</li>
  </ul>

  <figure class="media-band full-bleed" data-rise>
    <img src={url('/assets/photos/joe-911-vertical.jpg')} alt="Joe Neiman standing beside his white Porsche 911" width="738" height="1600" loading="lazy" style="object-position: center 30%;" />
  </figure>

  <!-- closer -->
  <section class="band band-light closer-band full-bleed" data-rise>
    <div class="band-inner">
      <span class="eyebrow">Contact</span>
      <div class="btn-row">
        <a class="cta cta-blue" href={linkedIn} rel="me">LinkedIn</a>
      </div>
    </div>
  </section>
</BaseLayout>
