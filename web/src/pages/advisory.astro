---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../consts';
---
<BaseLayout wide title="Advisory" path="/advisory" description="Where Joe Neiman advises and mentors: startup scaling, marketplaces, the auto business, and founders who want a sounding board.">
  <header class="page-title">
    <span class="eyebrow">Joe Neiman</span>
    <h1>Advisory and mentoring</h1>
  </header>

  <section class="chapter prose" data-rise>
    <p class="lede">
      I'm an advisor and mentor for FoodNerd. Other than that, I just dabble and
      get pulled into things in a very informal way. The areas where I can
      actually help are startup scaling, marketplaces, the auto dealer and used
      car business, and general aviation.
    </p>
  </section>

  <blockquote class="pullquote" data-rise>
    <p>&ldquo;Everything needs a soul. People are not robots.&rdquo;</p>
    <cite>Joe Neiman</cite>
  </blockquote>

  <div class="split flip" data-rise>
    <div>
      <h2>How I think about it</h2>
      <p>
        When I started ACV I had zero tech or startup experience other than
        survival mode of starting and running a used car dealership, and I knew
        absolutely nothing about raising capital from venture capitalists or how
        tech companies ran. I learned all of it the hard way, and that experience
        is what I have to offer somebody who is in the middle of it now.
      </p>
      <h2>Current roles</h2>
      <ul class="list-ruled">
        <li><strong>FoodNerd</strong>, advisor and mentor.</li>
      </ul>
    </div>
    <figure style="max-width: 420px;">
      <img src={url('/assets/photos/joe-headshot-brick.jpg')} alt="Joe Neiman headshot against a brick wall" loading="lazy" />
    </figure>
  </div>

  <!-- closer -->
  <section class="band band-light closer-band full-bleed" data-rise>
    <div class="band-inner">
      <span class="eyebrow">Advisory</span>
      <p>
        If you're building something in one of these areas,
        <a href={url('/contact')}>reach out</a>.
      </p>
      <div class="btn-row">
        <a class="btn" href={url('/contact')}>Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
