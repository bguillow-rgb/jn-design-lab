---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../consts';
---
<BaseLayout wide title="Writing" path="/writing" description="Essays from Joe Neiman on entrepreneurship, deals, flying, and health. A book is on the way.">
  <header class="page-title">
    <span class="eyebrow">Joe Neiman</span>
    <h1>Writing</h1>
  </header>

  <section class="chapter prose" data-rise>
    <p class="lede">
      I'm writing one substantial piece at a time, about the decisions I've
      made, the opportunities I chased or passed on, and the stories from the
      auction business and the hangar.
    </p>
    <p>
      The essays feed the bigger project, which is a book about entrepreneurship
      built from what actually happened to me over the past twenty years,
      including the failures and mistakes that I learned the most from.
    </p>
  </section>

  <figure class="media-band full-bleed" data-rise>
    <img src={url('/assets/photos/joe-911-roof.jpg')} alt="Joe Neiman leaning on the roof of his white Porsche 911" style="object-position: center 20%;" width="1800" height="1200" loading="lazy" />
  </figure>

  <!-- closer -->
  <section class="band band-light closer-band full-bleed" data-rise>
    <div class="band-inner">
      <span class="eyebrow">Writing</span>
      <p class="muted">
        Want the pieces as they come out? A newsletter signup will live here.
      </p>
      <div class="btn-row">
        <a class="btn" href={url('/contact')}>Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
